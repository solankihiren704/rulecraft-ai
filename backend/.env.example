# Copy this file to backend/.env and fill in real values. Never commit .env.
DATABASE_URL="postgresql://rulecraft:rulecraft@localhost:5432/rulecraft_ai?schema=public"

JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-secret"
JWT_REFRESH_EXPIRES_IN="7d"

PORT=4000
NODE_ENV=development
FRONTEND_URL="http://localhost:5173"

GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Report file storage. "local" writes under STORAGE_LOCAL_PATH; a future
# "s3" driver would add its own STORAGE_S3_* variables here without any
# change to reports business logic (see src/modules/reports/storage).
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
