# =============================================================================
# RuleCraft AI - Environment Variables
# Copy this file to backend/.env and fill in real values.
# NEVER commit the real .env file.
# =============================================================================

# --- Database ---------------------------------------------------------------
# PostgreSQL connection string used by Prisma.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://rulecraft:rulecraft@localhost:5432/rulecraft_ai?schema=public"

# --- Auth --------------------------------------------------------------------
# Long random string used to sign access JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="15m"

# Long random string used to sign refresh tokens (must differ from JWT_SECRET)
JWT_REFRESH_SECRET="replace-with-a-different-long-random-secret"
JWT_REFRESH_EXPIRES_IN="7d"

# --- Server ------------------------------------------------------------------
PORT=4000
NODE_ENV=development

# URL of the frontend app, used for CORS
FRONTEND_URL="http://localhost:5173"

# --- AI (Google Gemini) -------------------------------------------------------
# Get a key from https://aistudio.google.com/app/apikey
# The app must keep working (core rule engine) even if this is left blank.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# --- Rate limiting -------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# --- Report file storage ------------------------------------------------------
# "local" writes generated reports under STORAGE_LOCAL_PATH. A future "s3"
# driver would add its own STORAGE_S3_* variables here without any change
# to Reports business logic (see backend/src/modules/reports/storage.ts).
# Note: STORAGE_DRIVER is validated but not currently branched on anywhere
# in code — "local" is the only implementation that exists.
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
